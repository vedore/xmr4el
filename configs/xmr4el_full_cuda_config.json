{
    "vectorizer_config": {
        "type": "tfidf",
        "kwargs": {
            "analyzer": "char_wb",
            "ngram_range": [2, 4],
            "sublinear_tf": true,
            "max_df": 1.0
        }
    },
    "transformer_config": {
        "type": "sapbert",
        "kwargs": {"batch_size": 256}
    },
    "dimension_config": {
        "type": "sklearntruncatedsvd",
        "kwargs": {"n_components": 768, "random_state": 42}
    },
    "context_vectorizer_config": {
        "type": "tfidf",
        "kwargs": {
            "ngram_range": [1, 1],
            "stop_words": "english",
            "sublinear_tf": true,
            "max_df": 1.0
        }
    },
    "context_dimension_config": {
        "type": "sklearntruncatedsvd",
        "kwargs": {"n_components": 768, "random_state": 42}
    },
    "context_window": 10,
    "abbrev_expansion": "append",
    "clustering_config": {
        "type": "balancedkmeans",
        "kwargs": {
            "n_clusters": 8,
            "iter_limit": 20,
            "seed": 0
        }
    },
    "matcher_config": {
        "type": "jointlogisticregression",
        "kwargs": {"C": 1.0, "class_weight": "balanced", "tol": 0.001}
    },
    "min_leaf_size": 5,
    "cut_half_cluster": false,
    "depth": 4,
    "emb_flag": 6,
    "verbose": 1,
    "train_rankers": false
}
