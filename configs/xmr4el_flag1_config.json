{
    "vectorizer_config": {
        "type": "tfidf",
        "kwargs": {
            "max_features": 30000
        }
    },
    "dimension_config": {
        "type": "sklearntruncatedsvd",
        "kwargs": {
            "n_components": 1500,
            "algorithm": "randomized",
            "n_iter": 5,
            "n_oversamples": 10,
            "power_iteration_normalizer": "auto",
            "random_state": 42,
            "tol": 0.0
        }
    },
    "clustering_config": {
        "type": "balancedkmeans",
        "kwargs": {
            "n_clusters": 6,
            "iter_limit": 20
        }
    },
    "matcher_config": {
        "type": "sklearnsgdclassifier",
        "kwargs": {
            "loss": "log_loss",
            "penalty": "l1",
            "alpha": 0.0001,
            "max_iter": 1000,
            "tol": 0.0001,
            "class_weight": "balanced",
            "n_jobs": -1,
            "random_state": 42,
            "verbose": 0,
            "early_stopping": true,
            "learning_rate": "optimal"
        }
    },
    "ranker_config": {
        "type": "sklearnsgdclassifier",
        "kwargs": {
            "loss": "log_loss",
            "penalty": "l1",
            "alpha": 0.0001,
            "max_iter": 1000,
            "tol": 0.0001,
            "n_jobs": -1,
            "random_state": 42,
            "verbose": 0,
            "early_stopping": false,
            "learning_rate": "adaptive",
            "eta0": 0.01
        }
    },
    "cur_config": {
        "E_warm": 1,
        "ratios_warm": [
            0.7,
            0.3
        ],
        "ratios_hard": [
            0.6,
            0.3,
            0.1
        ],
        "neg_mult": 5,
        "seed": 42
    },
    "min_leaf_size": 5,
    "max_leaf_size": 200,
    "cut_half_cluster": true,
    "ranker_every_layer": true,
    "train_rankers": false,
    "depth": 2,
    "emb_flag": 1,
    "verbose": 1
}