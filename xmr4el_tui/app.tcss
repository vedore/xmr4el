TopBar {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $panel;
}

* {
    scrollbar-size: 1 1;
    scrollbar-color: $foreground 25%;
    scrollbar-color-hover: $foreground 40%;
    scrollbar-color-active: $foreground 50%;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
}

HelpPanel {
    width: 40;
    min-width: 40;
    max-width: 40;
}

#dash {
    height: 1fr;
}

#explorer {
    width: 40%;
    min-width: 30;
    max-width: 60;
    height: 1fr;
}

#dash-right {
    width: 1fr;
}

#description {
    height: 2fr;
    padding: 0 1;
}

#active-runs {
    height: 1fr;
}

#explorer, #description, #active-runs {
    border: round $foreground 30%;
    border-title-color: $foreground 60%;
}

#explorer:focus, #description:focus, #active-runs:focus {
    border: round $accent;
    border-title-color: $accent;
}
