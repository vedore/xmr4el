/* One style for every screen; only theme variables (app.THEME), so a later theme needs no CSS change. */

Screen {
    background: $background;
}

TopBar {
    dock: top;
    height: 1;
    background: $surface;
    color: $foreground-muted;
}

TopBar > .topbar--title {
    color: $foreground;
    text-style: bold;
}

TopBar > .topbar--area {
    color: $foreground-muted;
}

TopBar > .topbar--current {
    color: $block-cursor-foreground;
    background: $accent;
    text-style: bold;
}

* {
    scrollbar-size: 1 1;
    scrollbar-color: $foreground 25%;
    scrollbar-color-hover: $foreground 40%;
    scrollbar-color-active: $foreground 50%;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
}

/* the rule above would give a too-narrow footer a scrollbar row that hides its keys */
Footer {
    scrollbar-size: 0 0;
}

HelpPanel {
    width: 40;
    min-width: 40;
    max-width: 40;
}

#dash {
    height: 1fr;
}

/* width is set by DashboardScreen.set_left_width (resizable, clamped) */
#explorer {
    height: 1fr;
}

#dash-right {
    width: 1fr;
}

#description {
    height: 2fr;
}

#active-runs {
    height: 1fr;
}

/* Panels: muted border; the focused one gets the accent border and title. The cursor row of a blurred panel
   keeps a dim accent background (selected, not focused). */
#explorer, #description, #active-runs {
    background: $surface;
    border: round $border-blurred;
    border-title-color: $foreground-muted;
}

#explorer:focus, #description:focus, #active-runs:focus {
    border: round $border;
    border-title-color: $accent;
    border-title-style: bold;
}

Description > .option-list--option-disabled {
    color: $foreground;
}

/* Log panel (widgets/log_panel.py): the fullscreen viewer and the Run monitor's Live logs */
LogPanel {
    height: 1fr;
}

#log-header {
    height: 1;
    background: $surface;
}

#log-view, #log-missing {
    height: 1fr;
    background: $surface;
}

#log-missing {
    padding: 1 2;
}

#log-search {
    dock: bottom;
}

/* Run monitor (screens/monitor_screen.py): the left column's width is set by RunMonitorScreen.layout_columns */
#mon, #mon-left {
    height: 1fr;
}

#mon-right {
    width: 1fr;
}

#overview {
    height: auto;
    max-height: 50%;
    padding: 0 1;
}

#overview-text {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#overview-banner, #cancel {
    margin-top: 1;
}

#pipeline {
    height: 1fr;
    overflow-x: hidden;
}

#resources {
    height: 35%;
    min-height: 9;
    padding: 0 1;
}

#overview, #pipeline, #resources, LogPanel {
    background: $surface;
    border: round $border-blurred;
    border-title-color: $foreground-muted;
}

#overview:focus-within, #pipeline:focus, #resources:focus, LogPanel:focus-within {
    border: round $border;
    border-title-color: $accent;
    border-title-style: bold;
}

/* Cancel Run confirmation (screens/stop_dialog.py) */
StopDialog {
    align: center middle;
}

#stop-box {
    width: 64;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: round $error;
}

#stop-text {
    margin: 1 0;
}

#stop-buttons {
    height: 1;
}

#stop-buttons Button {
    margin: 0 4 0 0;
}

/* Results (screens/results_screen.py): the left column's width is set by ResultsScreen.set_left_width. Row states
   of the explorer (cursor, member, baseline) are painted by ResultsExplorer from the same theme tokens. */
#res, #res-left, #res-right, #res-compare {
    height: 1fr;
}

#res-right {
    width: 1fr;
}

#baseline {
    height: auto;
    padding: 0 1;
}

#res-explorer {
    height: 1fr;
}

/* Show incompatible: a one-row view filter over the explorer (not a comparison checkbox) */
#show-all {
    width: 100%;
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface;
    color: $foreground-muted;
}

#show-all:focus {
    color: $foreground;
    background: $xmr-cursor-row;
}

#summary {
    height: auto;
    max-height: 50%;
    padding: 0 1;
}

#analysis {
    height: 1fr;
}

#analysis-table {
    height: 1fr;
    background: $surface;
}

#analysis-table > .datatable--cursor {
    background: $xmr-cursor-row;
    color: $foreground;
    text-style: none;
}

#analysis-notes {
    height: auto;
    margin: 1 0 1 0;
    padding: 0 1;
    color: $foreground-muted;
}

#inspect {
    height: 1fr;
    padding: 0 1;
}

#baseline, #res-explorer, #summary, #analysis, #inspect {
    background: $surface;
    border: round $border-blurred;
    border-title-color: $foreground-muted;
    border-subtitle-color: $foreground-muted;
}

#res-explorer:focus, #summary:focus, #analysis:focus-within, #inspect:focus {
    border: round $border;
    border-title-color: $accent;
    border-title-style: bold;
}

#res-explorer:disabled {
    opacity: 60%;
}
