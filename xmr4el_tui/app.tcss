TopBar {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $panel;
}

#runs {
    height: 1fr;
}

#filter {
    height: 3;
}

.side-panel {
    split: right;
    width: 40;
    height: 1fr;
    border-left: vkey $foreground 30%;
}

.-narrow .side-panel {
    split: none;
    width: 1fr;
    height: auto;
    max-height: 12;
    border-left: none;
    border-top: hkey $foreground 30%;
}

#details {
    padding: 1 2;
}

HelpPanel {
    width: 40;
    min-width: 40;
    max-width: 40;
}

#overview-text, #inputs-text, #compare-text {
    padding: 1 2;
}

#logview {
    padding: 0 1;
}

#split {
    width: 30;
    margin: 1 2 0 2;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
}

.side {
    height: auto;
    padding: 0 1;
}

.side Static {
    width: auto;
    padding: 0;
}

.side Select {
    width: 24;
}

.-narrow #details {
    padding: 0 2;
}
