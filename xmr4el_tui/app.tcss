TopBar {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $panel;
}

* {
    scrollbar-size: 1 1;
    scrollbar-color: $foreground 25%;
    scrollbar-color-hover: $foreground 40%;
    scrollbar-color-active: $foreground 50%;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
}

#body {
    height: 1fr;
}

.-narrow #body {
    layout: vertical;
}

#runs, #trees {
    width: 1fr;
    height: 1fr;
}

#filter {
    height: 3;
}

.side-panel {
    width: 40;
    height: 1fr;
    border-left: vkey $foreground 30%;
}

.-narrow .side-panel {
    width: 1fr;
    height: auto;
    max-height: 12;
    border-left: none;
    border-top: hkey $foreground 30%;
}

#details {
    padding: 1 2;
}

HelpPanel {
    width: 40;
    min-width: 40;
    max-width: 40;
}

#overview-text, #inputs-text, #compare-text {
    padding: 1 2;
}

#logview {
    padding: 0 1;
}

#split {
    width: 30;
    margin: 1 2 0 2;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
}

.side {
    height: auto;
    padding: 0 1;
}

.side Static {
    width: auto;
    padding: 0;
}

.side Select {
    width: 24;
}

.-narrow #details {
    padding: 0 2;
}

#form {
    padding: 1 1;
}

.row {
    height: 1;
}

.row Label {
    width: 17;
}

.row Input {
    width: 48;
}

.hint {
    width: auto;
    padding: 0 0 0 2;
    color: $text-muted;
}

.error {
    color: $error;
    padding: 0 0 0 17;
}

.note {
    color: $text-muted;
    padding: 0 0 0 17;
}

.eval {
    height: auto;
    margin: 1 0 0 0;
}

.eval-head {
    height: 1;
}

.eval-head Label {
    width: 48;
    text-style: bold;
}

#add {
    margin: 1 0 0 0;
}

#check-line, #start-line {
    margin: 1 0 0 0;
}

#review-text {
    padding: 1 1 0 1;
}

#review-buttons {
    height: 1;
    margin: 1 1;
}

#review-buttons Button {
    margin: 0 4 0 0;
}

.row Select {
    width: 48;
}

.row Checkbox {
    width: 48;
}

.row #tree {
    width: auto;
}

SpecPicker {
    align: center middle;
}

#picker {
    width: 70;
    height: 24;
    padding: 1 2;
    background: $panel;
    border: round $primary;
}

#pick-list {
    height: 1fr;
    margin: 1 0 0 0;
}

#tree-details {
    padding: 1 2;
}

#run-actions {
    height: 1;
    margin: 0 1;
}

#stop-line {
    width: 1fr;
    padding: 0 0 0 1;
}

StopModal {
    align: center middle;
}

#stop-box {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: round $error;
}

#stop-text {
    margin: 1 0;
}

#stop-buttons {
    height: 1;
}

#stop-buttons Button {
    margin: 0 4 0 0;
}
